{
  // Název musí odpovídat názvu Workeru v Cloudflare dashboardu.
  "name": "web",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",

  // Statický web ze složky public/. Admin a API vždy nejdřív projdou Workerem
  // (kvůli ověření přihlášení), ostatní soubory se servírují přímo.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Všechny stránky webu (SPA) musí jít přes Worker, jinak Cloudflare při obnovení stránky vrátí 404.html.
    // Seznam musí odpovídat funkci jeStranka() v src/seo.js.
    "run_worker_first": ["/", "/admin", "/admin/*", "/api/*", "/robots.txt", "/sitemap.xml",
      "/novinky", "/novinky/", "/zive", "/zive/", "/streameri", "/streameri/", "/hry", "/hry/", "/prehled", "/prehled/",
      "/porovnat", "/porovnat/", "/report", "/report/*", "/cestina", "/cestina/", "/hlidac", "/hlidac/", "/stav", "/stav/",
      "/vydani", "/vydani/", "/akce", "/akce/", "/studia", "/studia/", "/studio/*", "/clanek/*", "/hra/*", "/streamer/*",
      "/pruvodce", "/pruvodce/", "/obchody", "/obchody/", "/ranni", "/ranni/", "/aktualizace", "/aktualizace/", "/ceska-scena", "/ceska-scena/",
      "/co-hrat", "/co-hrat/", "/rozjede-se", "/rozjede-se/", "/vyssi-nizsi", "/vyssi-nizsi/"],
    // Neexistující adresa → public/404.html se stavem 404.
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "herni-puls-db",
      "database_id": "c2962ce9-e393-4606-8734-b517dff06679"
    }
  ],

  // Záložní AI model (Cloudflare Workers AI).
  "ai": { "binding": "AI" },

  // */15 = novinky, "7" = psaní článků (jen v HODINY), "5,20,35,50" = streameři, "25" = herní katalog (Steam, Epic, GOG), "40" = videa z YouTube a klipy. Tím je 5 z 5 Cronů obsazeno.
  "triggers": {
    "crons": ["*/15 * * * *", "7 * * * *", "5,20,35,50 * * * *", "25 * * * *", "40 * * * *"]
  },

  // Nastavení. Tajné klíče (GROQ_API_KEY) sem NEPATŘÍ – ty jsou v Cloudflare jako Secret.
  "vars": {
    "PUBLIKOVAT": "auto",           // "auto" = zveřejnit, když projde kontrolou; "schvalit" = vždy čeká na schválení
    "CLANKU_DENNE": "5",
    "HODINY": "8,11,14,17,20",       // hodiny (pražský čas), kdy AI píše
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "TWITCH_CLIENT_ID": "hadu9ietlu5cqblcmltkwr229377fk", // veřejné ID aplikace; tajný klíč je Secret TWITCH_CLIENT_SECRET
    "KICK_CLIENT_ID": "01M8BFXYA9QQ3EMCCZWBP6TA9M", // veřejné ID aplikace; tajný klíč je Secret KICK_CLIENT_SECRET
    "SITE_URL": "https://web.hrajemespolu11.workers.dev", // adresa webu (odkazy v Discord oznámeních); změní se s vlastní doménou
    "CF_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "ACCESS_TEAM_DOMAIN": "",        // doplní se po nastavení Cloudflare Access, např. "mojejmeno.cloudflareaccess.com"
    "ACCESS_AUD": ""                 // doplní se po nastavení Cloudflare Access (Application Audience tag)
  },

  "observability": { "enabled": true }
}
